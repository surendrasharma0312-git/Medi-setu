# Copy to ".env.local" for local overrides. Never commit real credentials.

# Sub-path the app is served from. Use "/" locally or for a user/organisation
# GitHub Pages site. For a project site use "/<repository-name>/".
# (The GitHub Actions workflow sets this automatically.)
VITE_BASE_PATH=/

# --- Reserved for the backend phase (see docs/ROADMAP.md) ---
# Supabase URL and anon (public) key are safe for the browser by design.
# The service-role key must NEVER be placed in any frontend env file.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
